#!/usr/bin/env python3
"""
bench-model — benchmark a new model with one command.

This is the entry point for the whole "I downloaded a model, measure it" flow.
Designed so a SMALL local model can drive it: the agent doesn't infer anything or
assemble a config, it just passes a model name.

  bench-model --list-new                 which models have no result yet
  bench-model qwen3-32b                  measure one model (name from --list-new)
  bench-model ~/models/foo/bar.gguf      or by path (first shard of a split model)
  bench-model --all-new                  measure everything unmeasured
  bench-model qwen3-32b --quick          throughput only, skip the thermal test
  bench-model qwen3-32b --gpus 4         force the number of GPUs
  bench-model --reindex                  rebuild results/all-benchmark-results.md

WHAT IT DOES SO THE CALLER DOESN'T HAVE TO THINK

  1. Sizes the model from ALL its shards and picks the SMALLEST number of discrete GPUs
     it fits on (weights <= 75 % of their VRAM — the rest is KV cache and compute
     buffers). The integrated GPU is never used. More cards than needed only add
     hand-offs between them in layer split, so fewer is faster for decode.
  2. Checks hardware state of EVERY chosen GPU before measuring, and refuses to start on
     a hot card, non-zero error counters, a GPU held by another process, or a model
     left loaded in llama-swap — the result would be void anyway.
  3. Runs TWO tests, because one is not enough:
       throughput  (-p 512  -n 128)   short; measures tok/s
       thermal     (-p 4096 -n 1024)  long;  measures real temperature and power
     Without the long test, fast MoE models report an absurd ~19 W peak, because the
     entire computation finishes faster than the telemetry sampling period.
  4. Generates the config and calls bench.py, which holds the actual methodology
     (separate processes, condition recording, ECC/AER before and after, thermal guard
     on all GPUs) and writes the detailed report + the row in the shared table.
  5. Prints ONE final line, `VERDICT: ...`, for the caller to act on.

Settings used for every model (so rows are comparable): llama.cpp defaults for
batch/ubatch and KV cache, flash attention ON (as llama-server serves it), split
`layer` with equal shares, `--load-mode dio` for models over 40 GiB (ROCm mmap hang,
TECHNIKA P16).

Environment overrides: see bench.py (RIG_GPU_INDEX, RIG_MODELS_DIR, LLAMA_CPP_DIR).

License: MIT
"""

import argparse
import importlib.util
import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

BASE = Path(__file__).resolve().parent
BENCH = BASE / "bench.py"


def _load_bench():
    loader = SourceFileLoader("bench", str(BENCH))
    spec = importlib.util.spec_from_loader("bench", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


B = _load_bench()
RESULTS, INDEX = B.RESULTS, B.INDEX

# Fraction of VRAM the weights may occupy. The rest is KV cache, which grows with
# context length, plus compute buffers — a model that exactly fills VRAM cannot run.
WEIGHTS_BUDGET_FRACTION = 0.75

# Above this junction temperature the card has not cooled down from a previous run,
# and the first run of a new series would start warm and measure low.
START_TEMP_MAX_C = 45

# Models above this size need --load-mode dio (ROCm HSA mmap-registration hang, P16).
DIO_THRESHOLD_GIB = 40


# -------------------------------------------------------------------- discovery

def discrete_gpus():
    """Discrete GPUs in HIP order: list of inventory dicts with 'hip_index'."""
    B.discover()
    out = []
    for hip, bdf in enumerate(B.HIP_BDFS or []):
        g = next((x for x in B.INVENTORY.values() if x.get("bdf") == bdf), None)
        if g and not B.is_igpu(g):
            out.append(dict(g, hip_index=hip))
    if not out:                                   # no rocminfo: trust amd-smi order
        out = [dict(g, hip_index=i) for i, g in sorted(B.INVENTORY.items())
               if not B.is_igpu(g)]
    return out


def choose_gpus(size_bytes, force=None):
    """Smallest set of discrete GPUs the weights fit on. -> (gpus, status)."""
    gpus = discrete_gpus()
    if not gpus:
        return [], "NO_GPU"
    if force:
        return gpus[:force], ("OK" if force <= len(gpus) else "NOT_ENOUGH_GPUS")
    need_mb = size_bytes / 2**20
    for n in range(1, len(gpus) + 1):
        vram = sum(g.get("vram_mb") or 0 for g in gpus[:n])
        if vram and need_mb <= vram * WEIGHTS_BUDGET_FRACTION:
            return gpus[:n], "OK"
    total = sum(g.get("vram_mb") or 0 for g in gpus)
    return gpus, ("TIGHT" if total and need_mb <= total * 0.92 else "DOES_NOT_FIT")


def already_measured():
    """Model names and model files that have a result (results.json or index row)."""
    names, paths = set(), set()
    for rj in RESULTS.glob("*/results.json"):
        try:
            rec = json.loads(rj.read_text())
        except Exception:
            continue
        for cell in rec.get("cells", []):
            if cell.get("runs") and any(r.get("results") for r in cell["runs"]):
                names.add(cell.get("model"))
                if cell.get("model_path"):
                    paths.add(os.path.expanduser(cell["model_path"]))
    if INDEX.exists():                            # manual rows (no results.json)
        rows, _ = B._parse_index(INDEX.read_text(encoding="utf-8"))
        names |= {r.get("model") for r in rows}
    return names, paths


def is_measured(name, m, names, paths):
    return (name in names or m.get("base") in names
            or str(Path(m["path"]).resolve()) in {str(Path(p).resolve()) for p in paths})


# -------------------------------------------------------------------- preflight

def preflight(gpus):
    """Return (ok, [messages]). Refuses to measure on a hot or unhealthy card."""
    msgs, ok = [], True
    idx = [g["amd_index"] for g in gpus]
    ms = B.gpu_metrics(idx)
    if not ms:
        return False, ["amd-smi not responding — cannot record conditions"]
    for i in idx:
        j = (ms.get(i) or {}).get("junction_c")
        if B._num(j) and j > START_TEMP_MAX_C:
            ok = False
            msgs.append(f"gpu{i}: NOT cooled down — junction {j} C (need <= "
                        f"{START_TEMP_MAX_C} C). Wait and retry")
    if ok:
        msgs.append("all GPUs cool: junction " + ", ".join(
            f"gpu{i} {(ms.get(i) or {}).get('junction_c')} C" for i in idx))
    snap = B.error_snapshot(gpus)
    for dev, e in snap["ecc"].items():
        if e.get("uncorrectable") not in (0, None):
            ok = False
            msgs.append(f"gpu{dev}: uncorrectable ECC = {e['uncorrectable']} — hardware "
                        f"fault, DO NOT measure")
    for bdf, a in snap["aer"].items():
        bad = (a.get("fatal") or 0) + (a.get("nonfatal") or 0)
        if bad:
            ok = False
            msgs.append(f"{bdf}: PCIe AER fatal/nonfatal = {bad} — physical problem, "
                        f"DO NOT measure")
    if ok:
        msgs.append("uncorrectable ECC = 0, PCIe AER fatal/nonfatal = 0 on every GPU")
    holders = B.gpu_consumers(idx)
    if holders:
        ok = False
        msgs.append("GPU is NOT exclusive — held by: " + ", ".join(
            f"gpu{h['gpu']} {Path(str(h['name'])).name} (pid {h['pid']})" for h in holders)
            + ". Stop them (an agent's model? a stray llama-server?) first")
    else:
        msgs.append("GPUs are exclusive")
    loaded = B.llama_swap_running()
    if loaded:
        ok = False
        msgs.append(f"llama-swap has {', '.join(map(str, loaded))} loaded — run: "
                    f"curl -X POST http://127.0.0.1:8080/api/models/unload")
    msgs.append("power caps: " + ", ".join(f"gpu{g['amd_index']} {B.power_cap_w(g)} W"
                                            for g in gpus))
    return ok, msgs


# ------------------------------------------------------------------ measurement

def build_config(name, path, gpus, size_gib, quick):
    hip = ",".join(str(g["hip_index"]) for g in gpus)
    env = {"HIP_VISIBLE_DEVICES": hip}
    if len(gpus) > 1:
        # Mandatory on multi-GPU AMD (harmless for llama.cpp's layer split, required the
        # moment anything uses RCCL): see configs/multi-gpu-EXAMPLE.json.
        env.update({"NCCL_PROTO": "Simple", "NCCL_P2P_DISABLE": "1"})
        split = ["-sm", "layer", "-ts", "/".join("1" for _ in gpus)]
    else:
        split = ["-sm", "none"]
    base = ["-ngl", "999", *split, "-fa", "1"]
    if size_gib > DIO_THRESHOLD_GIB:
        base += ["--load-mode", "dio"]
    cfgs = [{"name": "throughput", "env": env, "args": base + ["-p", "512", "-n", "128"]}]
    if not quick:
        # The long test exists so the thermal telemetry is MEANINGFUL. On a short test
        # a fast MoE model finishes in under a second and the sampler never sees the load.
        cfgs.append({"name": "thermal", "env": env,
                     "args": base + ["-p", "4096", "-n", "1024"]})
    return {"name": f"new-model-{name}", "runs": 3, "cooldown_s": 45,
            "temp_limit_c": 95, "models": [{"name": name, "path": str(path)}],
            "configs": cfgs}


def latest_result_dir(before):
    dirs = {p for p in RESULTS.glob("*") if (p / "results.json").exists()}
    new = dirs - before
    return max(new, key=lambda p: p.name) if new else None


def summarise_result(outdir):
    rec = json.loads((outdir / "results.json").read_text())
    lines, worst = [], "OK"
    rank = {"OK": 0, "WITH_CAVEAT": 1, "INVALID": 2}
    for cell in rec["cells"]:
        v, flags = B.verdict_for(rec, cell)
        worst = v if rank[v] > rank[worst] else worst
        pk = B.cell_peaks(cell)
        for test, s in B.summarise(cell).items():
            lines.append(f"  {cell['model']}/{cell['config']} {test}: {s['mean']:.2f} tok/s "
                         f"(spread {s['spread_pct']:.1f}%, n={s['n']}, peak junction "
                         f"{pk['junction_c']} C, GPUs sum {pk['power_w_total']} W)")
        for f in flags:
            lines.append(f"  <-- {f}")
    return worst, lines


def measure(name, m, quick, force_gpus):
    path = Path(m["path"])
    size_gib = m["bytes"] / 2**30
    shards = f"  (+{len(m['files']) - 1} more shards)" if len(m["files"]) > 1 else ""
    print(f"\n{'=' * 70}\n MODEL: {name}\n file : {path}{shards}"
          f"\n size : {size_gib:.1f} GiB\n{'=' * 70}")

    gpus, status = choose_gpus(m["bytes"], force_gpus)
    vram = sum(g.get("vram_mb") or 0 for g in gpus)
    print(f"\n[1/4] GPUs: {len(gpus)} × {gpus[0]['name'] if gpus else '?'} "
          f"({vram} MiB VRAM, HIP {','.join(str(g['hip_index']) for g in gpus)})")
    if status in ("DOES_NOT_FIT", "NO_GPU", "NOT_ENOUGH_GPUS"):
        print(f"      {status}: {size_gib:.1f} GiB of weights vs {vram / 1024:.1f} GiB of "
              f"VRAM. Part would spill to host RAM and you would be measuring PCIe, not "
              f"the GPUs. Use a smaller quant.")
        print(f"\nVERDICT: SKIPPED ({name}: larger than VRAM)")
        return "SKIPPED"
    if status == "TIGHT":
        print(f"      TIGHT (over {WEIGHTS_BUDGET_FRACTION:.0%} of all VRAM) — it may load, "
              f"but KV cache and compute buffers compete for the rest.")
    else:
        print(f"      OK, headroom for KV cache + buffers: {vram / 1024 - size_gib:.1f} GiB")

    print("\n[2/4] Hardware state before measuring")
    ok, msgs = preflight(gpus)
    for x in msgs:
        print(f"      {x}")
    if not ok:
        print(f"\nVERDICT: INVALID ({name}: preflight failed — see above)")
        return "INVALID"

    cfg = build_config(name, path, gpus, size_gib, quick)
    cfg_path = Path("/tmp") / f"bench-model-{name}.json"
    cfg_path.write_text(json.dumps(cfg, indent=2), encoding="utf-8")
    print(f"\n[3/4] Measuring: {len(cfg['configs'])} config(s) x {cfg['runs']} "
          f"independent processes (config: {cfg_path})")

    before = {p for p in RESULTS.glob("*") if (p / "results.json").exists()}
    rc = subprocess.call([sys.executable, str(BENCH), str(cfg_path)])
    outdir = latest_result_dir(before)
    if rc != 0 or not outdir:
        print(f"\nVERDICT: INVALID ({name}: bench.py returned no result)")
        return "INVALID"

    print("\n[4/4] Summary")
    verdict, lines = summarise_result(outdir)
    for line in lines:
        print(line)
    print(f"\n      report: {outdir / 'report.md'}")
    print(f"      index : {INDEX}")
    print(f"\nVERDICT: {verdict} ({name}: report in {outdir.name})")
    return verdict


def main():
    ap = argparse.ArgumentParser(description="Benchmark a new model with one command")
    ap.add_argument("model", nargs="?",
                    help="model name (see --list-new), or a path to a .gguf")
    ap.add_argument("--list-new", action="store_true", help="models with no result yet")
    ap.add_argument("--all-new", action="store_true", help="measure all unmeasured")
    ap.add_argument("--quick", action="store_true", help="skip the long thermal test")
    ap.add_argument("--gpus", type=int, help="force the number of GPUs")
    ap.add_argument("--reindex", action="store_true",
                    help="rebuild results/all-benchmark-results.md from existing results")
    args = ap.parse_args()

    if args.reindex:
        B.rebuild_index()
        return

    found = B.model_catalog()
    names, paths = already_measured()

    if args.list_new:
        print(f"\nModels with NO measurement:")
        new = {k: v for k, v in found.items() if not is_measured(k, v, names, paths)}
        if not new:
            print("  (none — everything measured)")
        for k, v in new.items():
            gs, st = choose_gpus(v["bytes"])
            print(f"  {k:<30} {v['bytes'] / 2**30:6.1f} GiB  -> {len(gs)} GPU(s) {st}  {v['path']}")
        print("\nAlready measured:")
        for k, v in found.items():
            if is_measured(k, v, names, paths):
                print(f"  {k}")
        print(f"\nIndex: {INDEX if INDEX.exists() else '(not created yet)'}\n")
        return

    targets = []
    if args.all_new:
        targets = [(k, v) for k, v in found.items() if not is_measured(k, v, names, paths)]
        if not targets:
            print("No unmeasured models.")
            return
    elif args.model:
        p = Path(os.path.expanduser(args.model))
        if p.is_file():
            files = B.model_files(p)
            hit = next(((k, v) for k, v in found.items()
                        if Path(v["path"]).resolve() == p.resolve()), None)
            targets = [hit or (p.parent.name.lower(), {"path": p, "files": files, "base": None,
                                                        "bytes": sum(f.stat().st_size for f in files)})]
        elif args.model in found:
            targets = [(args.model, found[args.model])]
        else:
            print(f"Unknown model '{args.model}'. Available: {', '.join(found) or 'none'}")
            print("Pass a name from --list-new, or a full .gguf path.")
            sys.exit(1)
    else:
        ap.error("pass a model, or --list-new / --all-new / --reindex")

    verdicts = {}
    for name, m in targets:
        verdicts[name] = measure(name, m, args.quick, args.gpus)
        if len(targets) > 1:
            time.sleep(60)   # cool down between models

    if len(verdicts) > 1:
        print(f"\n{'=' * 70}\n VERDICTS\n{'=' * 70}")
        for k, v in verdicts.items():
            print(f"  {v:<14} {k}")


if __name__ == "__main__":
    main()
